+
+/* Save the peer cert to the TOFU store. */
+static bool
+http_tfu_save_cert (const char *host, X509 *cert)
+{
+    char *path = http_tfu_cert_path(host);
+    FILE *fp;
+    bool  ok = false;
+
+    fp = fopen(path, "w");
+    if (fp == NULL) {
+        log_debug(NULL, "TOFU: cannot create %s: %s", path, strerror(errno));
+        mem_free(path);
+        return false;
+    }
+
+    fchmod(fileno(fp), 0600);
+
+    if (PEM_write_X509(fp, cert) == 1) {
+        ok = true;
+    } else {
+        log_debug(NULL, "TOFU: PEM_write_X509 failed for %s", path);
+        unlink(path);
+    }
+    fclose(fp);
+
+    mem_free(path);
+    return ok;
+}
+
+/* Build the pending cert file path (caller frees). */
+static char*
+http_tfu_pending_path (const char *host)
+{
+    char *path = mem_new(char, PATH_MAX);
+    snprintf(path, PATH_MAX, "%s/%s.crt.pending", TLS_CERT_DIR, host);
+    return path;
