+static bool
+http_tfu_save_pending (const char *host, X509 *cert)
+{
+    char *path = http_tfu_pending_path(host);
+    char *tmp_path = mem_new(char, PATH_MAX);
+    FILE *fp;
+    bool  ok = false;
+
+    snprintf(tmp_path, PATH_MAX, "%s.tmp", path);
+    fp = fopen(tmp_path, "w");
+    if (fp == NULL) {
+        log_debug(NULL, "TOFU: cannot create %s: %s", tmp_path, strerror(errno));
+        mem_free(tmp_path);
+        mem_free(path);
+        return false;
+    }
