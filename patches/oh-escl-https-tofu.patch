+/* Build the cert file path (caller frees). */
+static char*
+http_tfu_cert_path (const char *host)
+{
+    char *path = mem_new(char, PATH_MAX);
+    snprintf(path, PATH_MAX, "%s/%s.crt", TLS_CERT_DIR, host);
+    return path;
